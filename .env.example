# ============================================================
# 面談予約システム 環境変数のひな型
# Vercel の Project Settings → Environment Variables に設定します。
# ローカルで動かす場合は、このファイルを .env.local にコピーして値を入れてください。
# ============================================================

# --- 必須:データベース(Googleスプレッドシート) ---
# スプレッドシートURLの /d/ と /edit の間にある文字列
SPREADSHEET_ID=1bHwaha2FNB0kNRtgNjz6G6wsy2ryf5lTFy8oBmKu3aA

# サービスアカウントの鍵。次のどちらかの方法で設定します。
# 方法1(推奨): JSON鍵ファイルの中身をそのまま、または base64 にして貼り付ける
GOOGLE_SERVICE_ACCOUNT_JSON=

# 方法2: メールアドレスと秘密鍵を個別に設定する(改行は \n のままでよい)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@yyy.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- 必須:管理画面のログイン ---
ADMIN_ID=
ADMIN_PASSWORD=
# セッションCookieの署名に使う秘密の文字列。
# `openssl rand -base64 32` などで生成した推測されにくい値にしてください。
SESSION_SECRET=

# --- 必須:Cron(リマインドメール)の保護 ---
# Vercel Cron が自動で付与するトークン。任意の長い文字列を設定します。
CRON_SECRET=

# --- メール送信(どちらか一方を設定。未設定なら送信されずログに残るだけ) ---
# 方法1: Resend(サーバーレス向き。https://resend.com)
RESEND_API_KEY=
# 方法2: SMTP(Gmail など)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# 差出人。独自ドメインを検証済みのアドレスにしてください。
MAIL_FROM=面談予約システム <noreply@example.com>

# --- 任意 ---
# タイムゾーン(未設定なら Asia/Tokyo)
TIMEZONE=Asia/Tokyo

# 「通知先」シートに校舎のアドレスが無いときの予備の通知先
STAFF_NOTIFY_EMAIL=

# カレンダー出力の保存先Googleドライブフォルダ(サービスアカウントに編集権限が必要)
CALENDAR_OUTPUT_FOLDER_ID=1SzWdk5JFEs9Ca1oLKJX7_mFXjaJOvA9b

# 出力したカレンダーを自動で閲覧共有するアドレス(カンマ区切り)
CALENDAR_SHARE_WITH=
