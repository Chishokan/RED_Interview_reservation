# ============================================================
# 面談予約システム 環境変数のひな型
# Vercel の Project Settings → Environment Variables に設定します。
# ローカルで動かす場合は、このファイルを .env.local にコピーして値を入れてください。
# ============================================================

# --- 必須:データベース(Supabase) ---
# ダッシュボードのURL(.../project/<ここ>/...)がプロジェクトIDです。
# SUPABASE_URL は https://<プロジェクトID>.supabase.co になります。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 「秘密の」キーの方を入れます。次のどちらでも動きます。
#   ・Settings → API Keys → Secret keys で作る sb_secret_... のキー(推奨)
#   ・Settings → API Keys → Legacy タブの service_role キー(eyJ... で始まる)
# publishable / anon キーでは動きません(RLSにより何も読み書きできないため)。
# ブラウザからは絶対に使わないでください。サーバー側だけで使います。
SUPABASE_SERVICE_ROLE_KEY=

# --- 必須:管理画面のログイン ---
# 部門ごとに分けられます。部門別の値が無ければ ADMIN_ID / ADMIN_PASSWORD を使います。
# 部門名の部分は、その部門のURL(slug)を大文字にしたものです。
ADMIN_ID_RED=
ADMIN_PASSWORD_RED=
ADMIN_ID_CHUTOBU=
ADMIN_PASSWORD_CHUTOBU=
# 全部門で同じログインにする場合はこちらだけでも動きます
ADMIN_ID=
ADMIN_PASSWORD=
# セッションCookieの署名に使う秘密の文字列。
# `openssl rand -base64 32` などで生成した推測されにくい値にしてください。
SESSION_SECRET=

# --- 必須:Cron(リマインドメール)の保護 ---
# Vercel Cron が自動で付与するトークン。任意の長い文字列を設定します。
CRON_SECRET=

# --- メール送信(いずれか一つを設定。未設定なら送信されずログに残るだけ) ---
# 上から順に判定するので、GAS_MAIL_URL があれば SMTP_* が残っていても GAS が使われる。
#
# 方法1: GAS中継(gas/mail-relay.gs をウェブアプリとしてデプロイして使う)
# レンタルサーバーの国外IP制限に影響されず、DNS設定も不要。
# 差出人アドレスはGASを実行するGoogleアカウント固定になる(表示名だけ MAIL_FROM が効く)。
# 1日の送信上限に注意(無料の@gmailは100通/日、Workspaceは1500通/日)。
# GAS_MAIL_URL=https://script.google.com/macros/s/xxxxx/exec
# GAS_MAIL_TOKEN=

# 方法2: Resend(サーバーレス向き。https://resend.com)
RESEND_API_KEY=
# 方法3: SMTP(エックスサーバー、Gmail など)
# ※ Vercelは米国から接続するため、国外IP制限のあるサーバーでは拒否されることがある
# ポート465を指定した場合、SMTP_SECURE を書かなくてもSSLで接続します。
# エックスサーバーの例(ホスト名はサーバーパネルの「メールソフト設定」で確認):
# SMTP_HOST=svXXXX.xserver.jp
# SMTP_PORT=465
# SMTP_USER=noreply@example.co.jp
# SMTP_PASS=
# Gmail の例(2段階認証を有効にしてアプリパスワードを発行する):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# 差出人。独自ドメインを検証済みのアドレスにしてください。
MAIL_FROM=面談予約システム <noreply@example.com>

# --- 任意 ---
# タイムゾーン(未設定なら Asia/Tokyo)
TIMEZONE=Asia/Tokyo

# 校舎に通知先が設定されていないときの予備の通知先
STAFF_NOTIFY_EMAIL=

# 新規予約の通知を待つ上限(ミリ秒。未設定なら7000)
# 予約自体は先に保存されるので、メールサーバーが応答しないときは
# ここで打ち切って保護者に予約完了を返す。関数の実行上限より短くすること。
# NOTIFY_TIMEOUT_MS=7000

# --- LINE WORKS通知(中等部で使用。使わない場合は空のままで構いません) ---
# LINE WORKS Developer Console のBot・サービスアカウントの情報です。
# 送信先のトークルームIDは、管理画面の「システム設定」から校舎ごとに設定します。
LINE_WORKS_CLIENT_ID=
LINE_WORKS_CLIENT_SECRET=
LINE_WORKS_SERVICE_ACCOUNT=
LINE_WORKS_BOT_ID=
# 秘密鍵。改行は \n のままでも、実際の改行でも構いません。
LINE_WORKS_PRIVATE_KEY=
