# ============================================================
# 面談予約システム 環境変数のひな型
# Vercel の Project Settings → Environment Variables に設定します。
# ローカルで動かす場合は、このファイルを .env.local にコピーして値を入れてください。
# ============================================================

# --- 必須:データベース(Supabase) ---
# Supabaseのダッシュボード → Project Settings → API で確認できます。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role キー(secret と書かれている方)。
# ブラウザからは絶対に使わないでください。サーバー側だけで使います。
SUPABASE_SERVICE_ROLE_KEY=

# --- 必須:管理画面のログイン ---
ADMIN_ID=
ADMIN_PASSWORD=
# セッションCookieの署名に使う秘密の文字列。
# `openssl rand -base64 32` などで生成した推測されにくい値にしてください。
SESSION_SECRET=

# --- 必須:Cron(リマインドメール)の保護 ---
# Vercel Cron が自動で付与するトークン。任意の長い文字列を設定します。
CRON_SECRET=

# --- メール送信(どちらか一方を設定。未設定なら送信されずログに残るだけ) ---
# 方法1: Resend(サーバーレス向き。https://resend.com)
RESEND_API_KEY=
# 方法2: SMTP(Gmail など)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# 差出人。独自ドメインを検証済みのアドレスにしてください。
MAIL_FROM=面談予約システム <noreply@example.com>

# --- 任意 ---
# タイムゾーン(未設定なら Asia/Tokyo)
TIMEZONE=Asia/Tokyo

# 校舎に通知先が設定されていないときの予備の通知先
STAFF_NOTIFY_EMAIL=
